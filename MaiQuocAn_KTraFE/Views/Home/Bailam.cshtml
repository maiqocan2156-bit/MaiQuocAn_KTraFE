    <script>
        function changeQty(btn, delta) {
            var item = btn.closest('.cart-item');
            var qtyEl = item.querySelector('.qty-value');
            var qty = parseInt(qtyEl.textContent) + delta;
            if (qty < 1) qty = 1;
            qtyEl.textContent = qty;
            var price = parseFloat(item.getAttribute('data-price'));
            item.querySelector('.price-value').textContent = (price * qty).toFixed(2);
            updateCart();
        }

        function updateCart() {
            var items = document.querySelectorAll('#cartItems .cart-item');
            var totalQty = 0, subtotal = 0;
            for (var i = 0; i < items.length; i++) {
                var q = parseInt(items[i].querySelector('.qty-value').textContent);
                var p = parseFloat(items[i].getAttribute('data-price'));
                totalQty += q;
                subtotal += p * q;
            }
            document.getElementById('cartCount').textContent = totalQty;
            document.getElementById('totalItems').textContent = totalQty;
            document.getElementById('subtotal').textContent = subtotal.toFixed(2);
            document.getElementById('sidebarItems').textContent = totalQty;
            document.getElementById('sidebarSubtotal').textContent = subtotal.toFixed(2);
        }

        function deleteItem(e, link) {
            e.preventDefault();
            var item = link.closest('.cart-item');
            var hr = item.nextElementSibling;
            item.parentNode.removeChild(item);
            if (hr && hr.tagName === 'HR') hr.parentNode.removeChild(hr);
            updateCart();
        }

        function deselectAll(e) {
            e.preventDefault();
            var checks = document.querySelectorAll('#cartItems .item-check');
            for (var i = 0; i < checks.length; i++) {
                checks[i].checked = false;
            }
        }

        function addToCart(btn) {
            var box = btn.closest('.saved-item') || btn.closest('.addon-item');
            if (!box) return;

            var nameEl = box.querySelector('.item-name, .addon-name');
            var priceEl = box.querySelector('.saved-price, .addon-price');
            var imgEl = box.querySelector('img');

            var name = nameEl ? nameEl.textContent.trim() : 'Product';
            var imgSrc = imgEl ? imgEl.src : '';
            var priceText = priceEl ? priceEl.textContent.replace(/[^0-9.]/g, '') : '0';
            var price = parseFloat(priceText) || 0;

            var cartItems = document.getElementById('cartItems');
            var hr = document.createElement('hr');
            var div = document.createElement('div');
            div.className = 'cart-item';
            div.setAttribute('data-price', price.toFixed(2));
            div.innerHTML =
                '<input type="checkbox" checked class="item-check" />' +
                '<img src="' + imgSrc + '" class="item-img" alt="product" />' +
                '<div class="item-info">' +
                '<a href="#" class="item-name">' + name + '</a>' +
                '<p class="in-stock">In Stock</p>' +
                '<label class="gift-label"><input type="checkbox" /> This is a gift <a href="#">Learn more</a></label>' +
                '<div class="item-actions">' +
                '<div class="qty-box">' +
                '<button type="button" onclick="changeQty(this,-1)">−</button>' +
                '<span class="qty-value">1</span>' +
                '<button type="button" onclick="changeQty(this,1)">+</button>' +
                '</div>' +
                '<a href="#" onclick="deleteItem(event,this)">Delete</a>' +
                '<span class="sep">|</span>' +
                '<a href="#">Save for later</a>' +
                '<span class="sep">|</span>' +
                '<a href="#">Compare with similar items</a>' +
                '<span class="sep">|</span>' +
                '<a href="#">Share</a>' +
                '</div>' +
                '</div>' +
                '<div class="item-price">$<span class="price-value">' + price.toFixed(2) + '</span></div>';

            cartItems.appendChild(hr);
            cartItems.appendChild(div);
            updateCart();

            var oldText = btn.textContent;
            btn.textContent = 'Added ✓';
            btn.disabled = true;
            setTimeout(function () {
                btn.textContent = oldText;
                btn.disabled = false;
            }, 1500);
        }

        document.addEventListener('DOMContentLoaded', function () {
            updateCart();

            var btns1 = document.querySelectorAll('.add-cart-btn');
            for (var i = 0; i < btns1.length; i++) {
                btns1[i].onclick = function () { addToCart(this); };
            }

            var btns2 = document.querySelectorAll('.add-cart-btn-sm');
            for (var j = 0; j < btns2.length; j++) {
                btns2[j].onclick = function () { addToCart(this); };
            }
        });
    </script>
</body>
</html>